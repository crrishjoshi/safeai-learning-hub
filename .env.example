# Environment variable names only. Never commit a populated .env file.
# The browser may receive only the Supabase project URL and publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Never prefix these with VITE_ or import them into an app.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# At least 32 random characters. Changing it makes stored provider keys
# unreadable, so parents must re-enter keys (or run a re-encrypt job) after rotation.
API_KEY_ENCRYPTION_SECRET=
# Positive integer stored beside each encrypted key (defaults to 1). Increase it when the secret changes.
API_KEY_ENCRYPTION_KEY_VERSION=
# Server-only Vercel/Supabase scheduled retention route guard.
CRON_SECRET=
# Optional server-only model overrides, tried before the built-in candidate list
# (for example when a provider retires a default model). Leave blank to use the defaults.
OPENAI_MODEL=
ANTHROPIC_MODEL=
GOOGLE_MODEL=
